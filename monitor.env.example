# aesa-monitor 설정. 이 파일을 monitor.env로 복사해서 쓴다. 값이 없으면 기본값을 쓴다.

# 데이터 출처: copy(처리부가 보내는 복사본 수신) 또는 capture(처리부·모의기·운용통제기 사이 패킷 캡처)
MONITOR_SOURCE=copy
# capture: 표준 출력으로 pcap을 내는 명령. {port}는 처리부 서버 포트로 바뀐다. root나 cap_net_raw 권한이 필요하다.
# 처리부 보드에서 받으려면 예: "ssh root@192.168.10.20 tcpdump -i eth0 --immediate-mode -U -s 0 -w - tcp port {port}"
MONITOR_CAPTURE_COMMAND="tcpdump -i any --immediate-mode -U -s 0 -w - tcp port {port}"

# 녹화 세션 폴더를 만들 곳
MONITOR_RECORD_DIR=~/aesa-records
# 본문 글자 크기 (8~32). 화면에서 A+/A-로 바꾸면 종료할 때 저장된다.
MONITOR_FONT_SIZE=12
# 1이면 시작하자마자 녹화
MONITOR_AUTO_RECORD=0

# 처리부 로그 가져오기: local(처리부를 이 PC에서 실행) 또는 ssh(보드)
MONITOR_LOG_SOURCE=local
# local: 처리부를 실행한 폴더의 logs 폴더
MONITOR_LOG_LOCAL_DIR=
# ssh: 보드 접속 정보. 보드에 공개키가 등록되어 있어야 한다.
MONITOR_LOG_SSH_TARGET=root@192.168.10.20
MONITOR_LOG_SSH_PORT=22
MONITOR_LOG_REMOTE_DIR=/tmp/aesa/logs
MONITOR_LOG_SSH_OPTIONS="-o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedAlgorithms=+ssh-rsa -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
